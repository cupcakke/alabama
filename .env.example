# The repository root inside the container. The Dockerfile uses /app.
MCP_ROOT=/app

# Port is supplied automatically by most hosts (Render, Railway, etc.).
PORT=8000

# Optional: use the deployed server for citations instead of GitHub blob URLs.
# PUBLIC_BASE_URL=https://your-service.example.com

# Optional fallback citation base. Keep this as the branch containing the data.
CITATION_BASE_URL=https://github.com/cupcakke/alabama/blob/main

# Optional limits.
MAX_SEARCH_RESULTS=10
MAX_FETCH_CHARS=2000000
MAX_SNIPPET_CHARS=900
